{
  "$description": "Tier 3 — component tokens. Each aliases a tier-2 role, so it follows the theme; a host re-skins one component by setting the token on :root or on any ancestor, without touching the component CSS. Override with a role or palette token, never a raw value, and keep the pairs in scripts/contrast-pairs.mjs passing (they measure these tokens).",
  "rse": {
    "button": {
      "radius": {
        "$value": "{rse.radius.pill}",
        "$type": "dimension"
      },
      "primary-bg": {
        "$value": "{rse.color.primary}",
        "$type": "color"
      },
      "primary-bg-hover": {
        "$value": "{rse.color.primary-hover}",
        "$type": "color"
      },
      "primary-bg-active": {
        "$value": "{rse.color.primary-active}",
        "$type": "color"
      },
      "primary-fg": {
        "$value": "{rse.color.text-on-primary}",
        "$type": "color"
      },
      "secondary-bg": {
        "$value": "{rse.color.surface-primary-tint}",
        "$type": "color"
      },
      "secondary-bg-hover": {
        "$value": "{rse.color.surface-primary-tint-hover}",
        "$type": "color"
      },
      "secondary-fg": {
        "$value": "{rse.color.text-on-primary-tint}",
        "$type": "color"
      },
      "ghost-fg": {
        "$value": "{rse.color.text-on-primary-tint}",
        "$type": "color",
        "$description": "Ghost text uses the deeper purple: --rse-color-primary is only 4.44:1 on the hover surface."
      },
      "ghost-border": {
        "$value": "{rse.color.border-strong}",
        "$type": "color"
      },
      "ghost-bg-hover": {
        "$value": "{rse.color.surface-sunken}",
        "$type": "color"
      }
    },
    "input": {
      "radius": {
        "$value": "{rse.radius.md}",
        "$type": "dimension"
      },
      "bg": {
        "$value": "{rse.color.surface-card}",
        "$type": "color"
      },
      "fg": {
        "$value": "{rse.color.text-heading}",
        "$type": "color"
      },
      "border": {
        "$value": "{rse.color.border-strong}",
        "$type": "color",
        "$description": "The resting border is the only thing identifying the control: it must stay at 3:1 against the surface (WCAG 1.4.11)."
      },
      "border-focus": {
        "$value": "{rse.color.primary}",
        "$type": "color"
      },
      "border-invalid": {
        "$value": "{rse.color.danger}",
        "$type": "color"
      }
    },
    "card": {
      "radius": {
        "$value": "{rse.radius.lg}",
        "$type": "dimension"
      },
      "bg": {
        "$value": "{rse.color.surface-card}",
        "$type": "color"
      },
      "border": {
        "$value": "{rse.color.border-subtle}",
        "$type": "color"
      },
      "shadow": {
        "$value": "{rse.shadow.sm}",
        "$type": "shadow"
      },
      "shadow-hover": {
        "$value": "{rse.shadow.md}",
        "$type": "shadow"
      }
    }
  }
}
