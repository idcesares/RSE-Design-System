{
  "rse": {
    "font": {
      "family": {
        "$value": "'Montserrat',-apple-system,'Segoe UI',sans-serif",
        "$type": "fontFamily"
      },
      "weight-regular": {
        "$value": "400",
        "$type": "fontWeight"
      },
      "weight-medium": {
        "$value": "500",
        "$type": "fontWeight"
      },
      "weight-semibold": {
        "$value": "600",
        "$type": "fontWeight"
      },
      "weight-bold": {
        "$value": "700",
        "$type": "fontWeight"
      },
      "weight-extrabold": {
        "$value": "800",
        "$type": "fontWeight"
      },
      "weight-black": {
        "$value": "900",
        "$type": "fontWeight"
      },
      "size-display-1": {
        "$value": "clamp(2.75rem, 1rem + 2.9vw, 5rem)",
        "$type": "dimension"
      },
      "size-display-2": {
        "$value": "clamp(2.25rem, 1rem + 1.9vw, 3.75rem)",
        "$type": "dimension"
      },
      "size-h1": {
        "$value": "clamp(2rem, 1rem + 1.4vw, 2.75rem)",
        "$type": "dimension"
      },
      "size-h2": {
        "$value": "clamp(1.5rem, 1rem + 0.8vw, 1.75rem)",
        "$type": "dimension"
      },
      "size-h3": {
        "$value": "clamp(1.25rem, 1rem + 0.4vw, 1.375rem)",
        "$type": "dimension"
      },
      "size-h4": {
        "$value": "1.125rem",
        "$type": "dimension"
      },
      "size-body-lg": {
        "$value": "1.125rem",
        "$type": "dimension"
      },
      "size-body-md": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "size-body-sm": {
        "$value": "0.875rem",
        "$type": "dimension"
      },
      "size-caption": {
        "$value": "0.75rem",
        "$type": "dimension"
      },
      "size-eyebrow": {
        "$value": "0.8125rem",
        "$type": "dimension"
      }
    },
    "line-height": {
      "tight": {
        "$value": "1.08",
        "$type": "number"
      },
      "heading": {
        "$value": "1.2",
        "$type": "number"
      },
      "body": {
        "$value": "1.6",
        "$type": "number"
      }
    },
    "letter-spacing": {
      "tight": {
        "$value": "-0.02em",
        "$type": "dimension"
      },
      "eyebrow": {
        "$value": "0.14em",
        "$type": "dimension"
      }
    }
  },
  "$description": "Tier 2 — type. Montserrat only, 400–900. Fluid sizes grow with rem + vw so they also scale with browser zoom."
}
