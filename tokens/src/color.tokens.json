      "tint-pink": {
        "$value": "#fce9ea",
        "$type": "color",
        "$description": "Accent chip tints — the pale backing behind a Tag in each of the six accent families. Paired with the matching tint-*-ink as foreground. Themed: never hard-code these values in a component.",
        "$extensions": {
          "rse": {
            "modes": {
              "dark": "#3a2226",
              "contrast": "#f2f1ec"
            },
            "modeNotes": {
              "contrast": "High contrast drops chip hue on purpose: a pale tint behind mid-accent text never\nclears 4.5:1. Chips read as neutral pills here and are told apart by their label."
            }
