          "name": "Índigo",
          "color": "#4c549e"
        },
        {
          "slug": "green-light",
          "name": "Verde claro",
          "color": "#a3d864"
        },
        {
          "slug": "green",
          "name": "Verde",
          "color": "#85b73d"
        },
        {
          "slug": "green-dark",
          "name": "Verde escuro",
          "color": "#658e1e"
        },
        {
          "slug": "yellow-light",
          "name": "Amarelo claro",
